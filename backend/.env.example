# Cloud-360 LOCAL DEVELOPMENT environment for the backend.
#
# SCOPE: this file configures a bare-metal `uvicorn main:app` run on your own
# machine, and nothing else. The deployment stack does NOT read it -- deploys
# are configured by deploy/.env (template: deploy/.env.example, rendered by
# deploy/render-env.sh). Keeping the two apart is enforced by
# scripts/validate_env_contract.py.
#
#   cp backend/.env.example backend/.env    then fill in the values below
#
# backend/.env is gitignored, and that is the only thing keeping secrets out of
# the repository -- the contract secret-scanner cannot see backend/. Put keys
# here and nowhere else. Full walkthrough: LOCAL-DEV.md.

# --- LLM (A1 design agent, A3 review suggestions) -----------------------
# 供應商：openrouter（唯一可用值，本機與部署皆同）。
#
#   `LLM_PROVIDER=cli` 已退役（本檔原本的預設值就是它，所以照本檔複製出的
#   .env 會直接踩到）。A3 遷移到 LangGraph／OpenRouter 之後已無 claude CLI
#   子行程可認證，而該模式仍會刪除 ANTHROPIC_AUTH_TOKEN／BASE_URL——金鑰被
#   清空，而健康檢查仍回報正常，是一個靜默失敗。現在設它會退回 openrouter
#   並記一行 ERROR 說明。詳見 RAID R-11 與 services/llm_provider.py 檔頭。
LLM_PROVIDER=openrouter

# 以下只有 LLM_PROVIDER=openrouter 時才需要。
# 留空代表「沒設定」，會得到明確的錯誤訊息；填了佔位字串反而會被當成
# 真金鑰送出去，換來一個要追三層才看得懂的 401。
# 例：OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_API_KEY=

# Anthropic Agent SDK × OpenRouter（官方社群接法）
# https://openrouter.ai/docs/guides/community/anthropic-agent-sdk
# 這三個由程式自動填寫（來源為 OPENROUTER_API_KEY），通常不需要手動設定。
# 手動設定 ANTHROPIC_AUTH_TOKEN 時程式不會覆寫它。
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=

# 模型名稱。留空時用 google/gemini-3.7-flash。含「/」的 gateway 格式名稱
# 直接沿用，不再被任何模式過濾（cli 模式的 slug 過濾已隨該模式退役移除）。
LLM_MODEL=
# openrouter 模式下由程式自動設為 LLM_MODEL 的值；手動設定時它同時也是
# get_model_name()／get_review_model_name() 的最後一層 fallback。
# ANTHROPIC_DEFAULT_SONNET_MODEL=

# 可選：A1 設計／產圖 agent 專用模型。留空時用 google/gemini-2.5-flash。
# 見 services/llm_provider.py::get_design_model_name。
# （本區塊原本重複出現兩次且兩份敘述不一致，本輪合併為一。）
# DESIGN_LLM_MODEL=

# 可選：A3 評核建議改用較快的模型。留空時依 LLM_MODEL，再退回
# google/gemini-3.7-flash。見 get_review_model_name。
# REVIEW_LLM_MODEL=

# Agent SDK 輸出 token 上限（OpenRouter 餘額不足時可降低，預設 12000；對應 CLAUDE_CODE_MAX_OUTPUT_TOKENS）
LLM_MAX_OUTPUT_TOKENS=12000
# 送入 LLM 的架構 XML 字元上限（預設 32000）
LLM_XML_CONTEXT_MAX_CHARS=32000

# --- n8n（動態架構圖 icons）---------------------------------------------
# N8N_WEBHOOK URL 空白時走灰底佔位圖；帳密任一為空則不送 Basic Auth header，
# webhook 會回非 200，同樣落到灰底佔位圖（服務不會壞，但也不會有人通知你）。
# 例：https://your-n8n-instance.com/webhook/get-icon
N8N_WEBHOOK_URL=
N8N_USER=
N8N_PASSWORD=

# --- Runtime ------------------------------------------------------------
# Application Environment (local, staging, test)
APP_ENV=local

# 本機 PostgreSQL。用 docker 起一顆的指令見 LOCAL-DEV.md §2。
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cloud360

# JWT 簽章金鑰。APP_ENV=local/test/ci 未設定時會使用開發用 fallback；
# staging/production 缺 JWT_SECRET 會直接拒絕啟動。
JWT_SECRET=cloud360_secret_key_change_me_in_production

# 固定 bootstrap admin 只允許 local/test/ci，或非 local 明確 opt-in。
# 不要在對外環境開啟，除非是一次性、隔離的 demo stack。
# ALLOW_INSECURE_DEFAULT_USERS=false

# 11 位 persona demo 帳號只在 local 自動建立；test/ci 僅建立 admin，避免
# UI regression 的資料前提漂移。非 local 若要 demo personas 需另外明確 opt-in。
# ALLOW_INSECURE_DEFAULT_PERSONAS=false

# 全新 staging/production 若需要建立第一個 Platform_Admin，可設定強隨機臨時密碼；
# 登入後立即輪替帳密並清除此值。local/test 會自動使用 admin123。
# CLOUD360_BOOTSTRAP_ADMIN_PASSWORD=

# 允許的前端來源（CORS，逗號分隔）。這裡放的是本機 vite dev server 的位址；
# 部署環境的來源由 deploy/.env 的 PUBLIC_URL 決定，不要混寫在這裡。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- brain-infra（U1）：Redis session store ＋ 本機 embedding --------------
# 本機是 bare-metal：Redis 與（可選的）Ollama 要自己在主機上跑起來，不是 compose
# 起的。完整前置步驟見 LOCAL-DEV.md §1／§2。
#
# 本機用 localhost；部署 stack 用 compose 服務名（`redis`／`ollama`），由
# deploy/.env 決定，兩者不共用設定。
REDIS_URL=redis://localhost:6379/0

# Redis ACL 使用者。**不得為 `default`**（最小權限；部署端由 compose 的
# `--user` 建立同名使用者）。本機若跑的是沒設 ACL 的 Redis，就自己建一個：
#   redis-cli ACL SETUSER cloud360 on '>本機密碼' '~*' '+@all' '-@admin' '-@dangerous'
REDIS_USER=cloud360

# 上面那個使用者的密碼。本機值隨意，但不要用部署環境的那一個。
REDIS_PASSWORD=

# Embedding 提供者。允許值：ollama｜fastembed｜fulltext｜stub。
# required、**無預設**：值不在清單內或缺值時會啟動失敗並列出可選值。
#   ollama    **部署 stack 專用**——本機設得出合法值但連不上，見下方說明
#   fastembed 不另起服務，但**首次使用會下載**模型（ONNX，行程內執行）。
#             **本機要真的驗向量檢索，用這個。**
#   fulltext  不做向量檢索，退回全文搜尋；語意與向量檢索不同
#   stub      完全不算 embedding；CI 的 ui-regression stack 用的就是它
# 本機預設給 fulltext：零下載、零額外服務，而且不像 stub 那樣什麼都不做。
# 要真的驗記憶檢索時改成 fastembed（不是 ollama）。
EMBEDDING_PROVIDER=fulltext

# 只有 EMBEDDING_PROVIDER=ollama 時才會用到。**本機兩種失敗方式都不是「設不出來」：**
#
# （a）保留下面這個服務名 → **啟動會通過**（NFR7.1 驗的是主機名的形式，不是
#      可解析性；BR1.5 禁止啟動探測）。失敗發生在**第一次 embed()**，
#      是 EmbeddingProviderUnavailable 夾一個 ConnectError（名稱無法解析）。
# （b）改成 localhost／127.0.0.1／IP 字面值／對外網域 → **啟動就失敗**，
#      訊息會說主機名必須是 compose 內部服務名。
#
# 為什麼 NFR7.1 這麼嚴：該服務的 HTTP API 零認證、不 publish host port，
# 網段隔離是它唯一的存取控制；把 base URL 指到 compose 網路之外就是直接
# 繞過它——記憶文字會以明文送到那個位址。
#
# 本機要向量檢索請用 fastembed。此處留服務名形式，不留可直接貼上的 localhost 值。
OLLAMA_BASE_URL=http://ollama:11434
# dense 維度必須是 1024（與記憶表的 vector(1024) 欄位一致）。
OLLAMA_EMBED_MODEL=bge-m3

# 只有 EMBEDDING_PROVIDER=fastembed 時才會用到。維度亦須 1024。
FASTEMBED_MODEL=multilingual-e5-large

# --- session-store（U10）：大腦 session 的每段歷程上限 -------------------
# required、**無預設**（BR3.5／NFR8.40）：缺值時 backend 會在 startup 大聲失敗
# 並列出需要的設定，**不會**以「無上限」啟動——那會讓單一 Redis key 無上界
# 成長，而那是無聲的（既有前例是上面的 EMBEDDING_PROVIDER）。
#
# 值為 200（[N2]=A 的算式）：3 段 × 200 則 × 每則約 500 B ≈ 300 KB／session。
# 上限**每段獨立計算**，故總量上界是 3 倍而不是 200 則總和——套在總和上會讓
# 一頁的活躍對話擠掉另一頁的歷程，而兩者在使用者眼中無關。
#
# 本機也需要一顆 Redis（bare-metal，不是 compose 起的）；完整前置步驟見
# LOCAL-DEV.md §1。
BRAIN_SESSION_HISTORY_MAX=200

# --- intent-router（U11）：意圖路由層的五個設定 -------------------------
# 四個有預設、**一個刻意無預設**。前四個缺值時系統行為正確、只是沒照設定跑，
# 故取預設並記一行 WARN／INFO；門檻缺值則**反問路徑的判定基準不存在**，而那是
# FR1.3 這條 Must 的觸發條件，所以後端 startup 直接拒絕啟動（BR3.4 逐字
# 「缺值不得以預設值靜默啟動」）。既有同形前例就是上面的
# BRAIN_SESSION_HISTORY_MAX 與 EMBEDDING_PROVIDER。
#
# 路由層模型。**刻意不沿用 LLM_MODEL**——後者是 A1／A3 功能 agent 在用的，
# 共用會讓「編排層與功能 agent 得使用不同模型」在設定層消失（NFR10.60）。
# 換模型不需改程式，但**必須重跑 NFR1 的標註集**：準確率數字不可跨模型沿用。
BRAIN_ROUTER_MODEL=typesafe/jev-1.13

# 單次模型呼叫的硬逾時（秒，NFR3.61）。非正數或非數字會記 WARN 後取預設 5。
BRAIN_ROUTER_TIMEOUT_SEC=5

# 每輪最多幾次模型呼叫（NFR3.62）。意圖分類、槽位拆解、指涉詞解析合併為同一次
# 請求，所以正常值是 1。設 0 會讓每一輪立即以「已達上限」失敗。
BRAIN_ROUTER_MAX_CALLS_PER_TURN=1

# 重試次數（NFR3.63）。**0 是刻意的**：classify 非冪等（LLM 輸出可變），
# 重試不會「再試一次就會一樣」，只會把一次異常放大成一次帳單事件。
BRAIN_ROUTER_MAX_RETRIES=0

# 信心門檻（FR1.7 的初版 0.7）。required、**無預設**——缺它後端不啟動。
# 值域為 0 < t <= 1：門檻為 0 會讓「最高分 >= 門檻」恆真、反問路徑永不觸發，
# 而那正是 FR1.6 逐字警告的「FR1.3 靜默永不觸發，文件上看起來已解決」。
# 它是**設定值而非常數**，得依 NFR1 的校正程序調整；調整時必須同時處理
# NFR1 的準確率目標——調高門檻會讓系統多反問、少交辦，準確率的帳面數字因此
# 上升，但那不是識別變準了。
BRAIN_ROUTER_CONFIDENCE_THRESHOLD=0.7

# 選填，預設 10。embedding 外部呼叫的逾時上界（秒），非正數或非數字會記 WARN
# 後取預設，不終止啟動。它**不是**首字回應 P50 ≤ 2 秒那條預算的保護機制
# （10 秒是它的 5 倍），保護的是「提供者掛掉時不要無限期掛住記憶路徑」。
EMBEDDING_TIMEOUT_SEC=10

# --- Cost / FinOps（C1 — 查價 Port 存活集；舊 diagrams API／Calculator 已退場）---
# 查價順序：**檔案快取 → boto3 Pricing Query API → 公開 Bulk API**（不再寫 Postgres pricing_cache）。
# Query API 需 IAM（`pricing:GetProducts`）；無憑證時自動 fallback Bulk（較慢、免帳號）。
# COST_PRICING_USE_SDK=auto   # auto|1|0
# COST_PRICING_SDK_TIMEOUT=60
# COST_PRICING_USE_CLI=auto   # 舊名，等同 USE_SDK
# COST_PRICING_CLI_TIMEOUT=60 # 舊名，等同 SDK_TIMEOUT
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# GCP Cloud Billing Catalog API（https://cloudbilling.googleapis.com）
# GCP_BILLING_API_KEY=
# Bulk fallback 讀取逾時（秒）；預設 180。
# COST_PRICING_OFFER_READ_TIMEOUT=180
