# Cloud-360 LOCAL DEVELOPMENT environment for the frontend.
#
# SCOPE: this file configures `npm run dev` (vite dev server) on your own
# machine, and nothing else. The deployment stack does NOT read it -- compose
# passes VITE_API_BASE_URL as a build arg derived from PUBLIC_URL in
# deploy/.env, because Vite inlines env at build time rather than reading it at
# runtime. Keeping the two apart is enforced by
# scripts/validate_env_contract.py.
#
#   cp frontend/.env.example frontend/.env
#
# Full walkthrough: LOCAL-DEV.md.

# 後端 HTTP API 根 URL（勿加結尾斜線）。本機後端預設跑在 8000；
# LOCAL-DEV.md 用 8010 以避開常見的埠衝突，改埠時這裡要一起改。
VITE_API_BASE_URL=http://localhost:8000

# 可選：WebSocket 根 URL。未設定時由 VITE_API_BASE_URL 自動推導（http→ws、https→wss）
# VITE_WS_BASE_URL=ws://localhost:8000

# 可選：顯示 demo/persona 帳號快速填入。Vite dev mode 會自動顯示；
# production build 預設不顯示，除非明確設為 true。
# VITE_ENABLE_DEMO_QUICK_USERS=false
