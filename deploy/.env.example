# Cloud-360 DEPLOY-TIME environment for the staging host (192.168.10.10).
#
# SCOPE: this file configures deploy/docker-compose.deploy.yml and nothing else.
# It is NOT used for local development -- bare-metal dev reads backend/.env and
# frontend/.env (see backend/.env.example, frontend/.env.example and
# LOCAL-DEV.md). Keeping the two apart is enforced by
# scripts/validate_env_contract.py, which also checks that every value this
# stack needs is actually supplied.
#
# Two ways to produce the real deploy/.env, both writing the same variables:
#   - GitHub Actions: .github/workflows/deploy.yml runs deploy/render-env.sh,
#     which reads the repository secrets.
#   - By hand on the host: copy this file to deploy/.env and fill it in.
# Never commit the filled-in file -- scripts/validate_repo_contract.py rejects
# committed credentials.
#
# Not set here, because compose derives them and would ignore anything written:
#   DATABASE_URL        built from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
#   VITE_API_BASE_URL   the frontend build arg, taken from PUBLIC_URL

# --- Database -----------------------------------------------------------
# Left empty deliberately: a filled-in-looking placeholder (change_me) passes a
# casual review and ends up as the real database password. Generate one with
# `openssl rand -hex 32` -- and no `$`, which compose would truncate.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=cloud360

# --- Backend ------------------------------------------------------------
# JWT signing key. Generate with: openssl rand -hex 32
# Left empty deliberately, for the same reason as POSTGRES_PASSWORD above. It
# MUST be filled in: auth.py falls back to a key published in this repo when
# this is unset, and anyone could then forge an admin session. The GitHub
# Actions path cannot regress here -- deploy/render-env.sh refuses to render
# without it -- but a hand-copied file on the host has no such guard.
JWT_SECRET=

# Optional one-time bootstrap password for the `admin` Platform_Admin account.
# Leave empty on an already-initialized environment. For a brand-new staging
# database, set a strong temporary value through the GitHub secret
# CLOUD360_BOOTSTRAP_ADMIN_PASSWORD, log in once, then rotate/clear it.
CLOUD360_BOOTSTRAP_ADMIN_PASSWORD=

# A1 design agent — Anthropic Agent SDK routed through OpenRouter.
# Runtime still needs Claude Code CLI inside the backend image (see Dockerfile / DEPLOY.md §0).
#
# Always openrouter for a deployed stack. The alternative (cli) authenticates
# with an interactive `claude login`, which a container cannot do -- it is a
# local-development mode only, set in backend/.env.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_DEFAULT_SONNET_MODEL=google/gemini-3.7-flash
LLM_MODEL=google/gemini-3.7-flash
# Lower if OpenRouter returns 402 (credits / max_tokens). Maps to CLAUDE_CODE_MAX_OUTPUT_TOKENS.
LLM_MAX_OUTPUT_TOKENS=12000
LLM_XML_CONTEXT_MAX_CHARS=32000

# n8n webhook that serves the dynamic architecture icons, plus its basic-auth
# credentials. If either credential is empty the backend sends no auth header,
# the webhook answers non-200, and every icon silently degrades to the grey
# placeholder — the service stays up, so nothing else will tell you.
N8N_WEBHOOK_URL=
N8N_USER=
N8N_PASSWORD=

APP_ENV=staging

# --- Public surface -----------------------------------------------------
# Baked into the frontend bundle at build time (Vite inlines env), and the
# default for the backend's CORS allowlist.
PUBLIC_URL=https://cloud360.danniel.cc

# Optional CORS override. Compose defaults it to PUBLIC_URL, which is correct
# for the single-origin nginx topology; set it only when a second public origin
# genuinely needs access. Local dev origins do not belong here — the dev server
# talks to a dev backend, which has its own CORS_ORIGINS in backend/.env.
# CORS_ORIGINS=https://cloud360.danniel.cc

# Host port for the frontend nginx. Internal debugging only — the public path
# is the Cloudflare tunnel, which reaches nginx over the compose network.
FRONTEND_HOST_PORT=8090

# --- Cloudflare tunnel --------------------------------------------------
# Credentials JSON written by `cloudflared tunnel create cloud-360` on the host.
CLOUDFLARED_CREDENTIALS_FILE=/home/danniel-c/.cloudflared/b460a579-9e0d-42f1-a31d-c84d35bef065.json

# --- brain-infra（U1）：Redis session store ＋ 本機 embedding --------------
# 七個變數全部被 deploy/docker-compose.deploy.yml 以**無 `:-` fallback** 的形式
# 引用，所以它們是 required：少寫一個，scripts/validate_env_contract.py 就紅燈。
# 反過來也成立——在 compose 那邊補上 `:-` 不只是「加了預設值」，是**把這道閘門
# 拿掉**，於是變數變空字串、服務照常啟動、功能靜默降級。
#
# 這七個之中**只有 `REDIS_PASSWORD` 是憑證**；其餘六個是字面值，由
# deploy/render-env.sh 直接寫出，**不經 GitHub secrets**（沒有對應 secret 的名字
# 會解析成空字串，而 EMBEDDING_PROVIDER 缺值會讓 backend 拒絕啟動）。

# Redis 連線字串。主機名必須是 compose 內部服務名（`redis`），不是 localhost：
# 在部署 stack 裡 localhost 指向 backend 容器自己。**不帶帳密**——身分由下面兩個
# 變數表達，避免同一份憑證有兩個來源。
REDIS_URL=redis://redis:6379/0

# Redis ACL 專用使用者。**不得為 `default`**：以 default 連線取得的是 full
# command access（含 FLUSHALL／CONFIG／KEYS），那是最小權限的反面。
REDIS_USER=cloud360

# 上面那個 ACL 使用者的密碼。刻意留空，理由與 POSTGRES_PASSWORD 相同。
# 以 `openssl rand -hex 32` 產生，且**不得含 `$`**——docker compose 會對
# --env-file 的值做內插，`ab$cd` 會被無聲截斷成 `ab`，Redis 照樣接受、
# healthcheck 照樣過。deploy/render-env.sh 會擋下這兩種情況（空值與含 `$`）。
REDIS_PASSWORD=

# Embedding 提供者。允許值：ollama｜fastembed｜fulltext｜stub。
# required、**無預設**：偵測不到選定提供者時須大聲失敗，不得靜默降級。
# 部署 stack 用 ollama（同一台主機上的本機推論，對外部 API 花費貢獻為零）。
EMBEDDING_PROVIDER=ollama

# Ollama 服務位址。同樣必須是 compose 內部服務名，且該服務無 host port——
# 它的 HTTP API 零認證，網段隔離是它唯一的存取控制。
OLLAMA_BASE_URL=http://ollama:11434

# Embedding 模型。dense 維度必須是 1024（與記憶表的 vector(1024) 欄位一致）。
# 模型**不會**因為容器啟動就出現：deploy.yml 會在 up -d 之後跑一次 ollama pull。
OLLAMA_EMBED_MODEL=bge-m3

# EMBEDDING_PROVIDER=fastembed 時才會用到（行程內 ONNX，不另起服務）。維度亦須 1024。
FASTEMBED_MODEL=multilingual-e5-large

# --- C1 成本估價（可選）------------------------------------------------
# AWS：填入具 pricing:GetProducts 的 IAM 憑證可加速查價；留空則 fallback 公開 Bulk。
# GCP：要估 GCP 架構圖時填 Catalog API key（勿把真實金鑰 commit 進本檔）。
# Azure Retail Prices 公開免帳號，無需變數。
# COST_PRICING_USE_SDK=auto
# COST_PRICING_SDK_TIMEOUT=60
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# GCP_BILLING_API_KEY=
